# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Env / secrets
.env
.env.*

# OS
.DS_Store

# Scratch / cache, regenerated by the pipeline (see docs/RUNBOOK.md).
# Keep the tmp/ directory itself (tmp/.gitkeep), ignore everything in it.
tmp/*
!tmp/.gitkeep

# Default run-log output location (run_one_loop.py's own --run-log default)
data/outputs/

# Paper source and any PDFs are not distributed through this repo.
research-paper/
*.pdf
